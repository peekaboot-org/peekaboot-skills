<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath />
    </parent>

    <groupId>org.peekaboot.skills</groupId>
    <artifactId>test-app</artifactId>
    <version>0.0.0-SNAPSHOT</version>

    <properties>
        <java.version>25</java.version>
        <!-- Dev's snapshot until the agent API ships in 1.2.0; CI adds the snapshot repository
             through .github/ci/maven-settings.xml. -->
        <peekaboot.version>1.1.1-SNAPSHOT</peekaboot.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.peekaboot</groupId>
            <artifactId>peekaboot-spring-boot-starter</artifactId>
            <version>${peekaboot.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>test-app</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
